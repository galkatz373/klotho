(version:1,id:"kai-farm-a",owner:"Gal Katz",worker_classes:[(machine_id:"kai-dev-a",count:1,slots_each:1)],max_concurrency:1,queue_policy:"FIFO by immutable OutcomeId; retries retain metadata",cas_topology:"local APFS CAS on APPLE SSD AP0512Z",cache_topology:"one declared cold or warm cache; no hidden shared cache",storage_bandwidth:"local NVMe; each result records measured bytes/s",network_bandwidth:"no farm network; local loopback only",network_latency:"single-node lane, recorded as 0 ms",retry_policy:"at most 2 infrastructure retries; task failures are never omitted",scheduling:"exclusive, no oversubscription",measured_jobs_per_week:20)
