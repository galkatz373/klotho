[
    AddAffordance(Affordance(id: "Hittable", requires: [], grants: [], conflicts: [])),
    AddAffordance(Affordance(id: "Solid", requires: [], grants: [], conflicts: [])),
    AddAffordance(Affordance(id: "Projectile", requires: [], grants: [], conflicts: [])),
    AddAffordance(Affordance(
        id: "Armed",
        requires: [],
        grants: ["Fire"],
        conflicts: [],
    )),
    AddAffordance(Affordance(id: "Fragment", requires: [], grants: [], conflicts: [])),
    AddAffordance(Affordance(id: "Destructible", requires: [], grants: [], conflicts: [])),
    AddLaw(Law(
        id: "fire.hitscan",
        when: EqVerb(Fire),
        body: Pred(
            must: And(Affordance(Self, "Armed"), Qty(Self, "ammo", Ge, 1)),
            ought: None,
        ),
    )),
    AddRite(RiteGraph(id: "fire", cap_steps: 8, cap_ticks: 4, entry: 0, nodes: [
        { pc: 0, op: Bind(Self) },
        { pc: 1, op: Spend("ammo", 1, 4) },
        { pc: 2, op: Emit("Hit") },
        { pc: 3, op: Complete(Success) },
        { pc: 4, op: Complete(Fail) },
    ])),
    AddLaw(Law(
        id: "never_clip_closed",
        when: Or(SourceIs(Phys), Or(SourceIs(Space), SourceIs(Motion))),
        body: Pred(must: Not(SweptHitsOpaqueClosed), ought: None),
    )),
    AddLaw(Law(
        id: "projectile.cap",
        when: EqVerb(Fire),
        body: Cap(mark: Affordance(Self, "Projectile"), n: 512, require_rel: None),
    )),
    AddLaw(Law(
        id: "fragment.cap",
        when: EqVerb(Fire),
        body: Cap(mark: Affordance(Self, "Fragment"), n: 128, require_rel: None),
    )),
    AddRite(RiteGraph(id: "apply_hit", cap_steps: 24, cap_ticks: 4, entry: 0, nodes: [
        { pc: 0, op: Branch(Affordance(Self, "Destructible"), 10, 1) },
        { pc: 1, op: Spend("health", 25, 2) },
        { pc: 2, op: Branch(Qty(Self, "health", Le, 0), 3, 6) },
        { pc: 3, op: RelAdd(Self, Dead, Self) },
        { pc: 4, op: Setq(Self, "health", 0) },
        { pc: 5, op: Awake(Self) },
        { pc: 6, op: Complete(Success) },
        { pc: 10, op: Spend("integrity", 25, 11) },
        { pc: 11, op: Branch(Qty(Self, "integrity", Le, 0), 12, 16) },
        { pc: 12, op: Setq(Self, "integrity", 0) },
        { pc: 13, op: RelDel(Self, PartOf, Self) },
        { pc: 14, op: Awake(Self) },
        { pc: 15, op: Complete(Success) },
        { pc: 16, op: Complete(Success) },
    ])),
    AddRite(RiteGraph(id: "melee", cap_steps: 16, cap_ticks: 8, entry: 0, nodes: [
        { pc: 0, op: Bind(Target) },
        { pc: 1, op: Wait(2, Some(Aim)) },
        { pc: 2, op: Guard(And(InWindow("melee", Aim), And(SourceIs(Player), AgencyClaimed(Aim))), fail: 8) },
        { pc: 3, op: Wait(2, Some(Aim)) },
        { pc: 4, op: Guard(And(InWindow("melee", Aim), And(SourceIs(Player), AgencyClaimed(Aim))), fail: 8) },
        { pc: 5, op: Emit("Hit") },
        { pc: 6, op: Complete(Success) },
        { pc: 8, op: Complete(Fail) },
    ])),
    AddRite(RiteGraph(id: "collapse", cap_steps: 80, cap_ticks: 4, entry: 0, nodes: [
        Spawn("Fragment"),
        Spawn("Fragment"),
        Spawn("Fragment"),
        Spawn("Fragment"),
        Spawn("Fragment"),
        Spawn("Fragment"),
