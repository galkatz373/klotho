(
    id: "mini-tapestry-checkpoint",
    start: (name: "keep-locked"),
    steps: [
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyE],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("iron_key"),
        )),
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyR],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("kel"),
        )),
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyE],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("anvil"),
        )),
        Save(slot: "anvil"),
        Wait(ticks: 2),
        Load(slot: "anvil"),
    ],
    assertions: [
        Rel(a: "kel", rel: Dead, b: "kel", present: true),
        Rel(a: "iron_key", rel: OwnedBy, b: "player", present: true),
        Trace(contains: "Checkpoint"),
        Place(locus: "player", place: "hearth"),
    ],
    capture_points: [
        (name: "checkpoint_restored", after_step: 5, kind: semantic),
    ],
    max_ticks: 16,
    depends_on: ["mini-tapestry-combat"],
    anchors: [],
    modules: [],
)
