(
    id: "mini-tapestry-critical-path",
    start: (name: "keep-locked"),
    steps: [
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyE],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("iron_key"),
        )),
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyE],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("oak_door"),
        )),
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyR],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("kel"),
        )),
        Device(action: (
            player: PlayerId(0),
            buttons: [KeyE],
            stick_x: 0,
            stick_z: 0,
            look_yaw: 0,
            look_pitch: 0,
            phase: 0,
            target: Name("anvil"),
        )),
        Save(slot: "anvil"),
        Camera(name: "follow"),
        Camera(name: "credits"),
        Load(slot: "anvil"),
    ],
    assertions: [
        Rel(a: "iron_key", rel: OwnedBy, b: "player", present: true),
        Rel(a: "oak_door", rel: LockedBy, b: "oak_door", present: false),
        Rel(a: "kel", rel: Dead, b: "kel", present: true),
        Trace(contains: "Unlocked"),
        Trace(contains: "Hit"),
        Trace(contains: "Checkpoint"),
        Trace(contains: "Camera(follow)"),
        Trace(contains: "Camera(credits)"),
        Place(locus: "player", place: "hearth"),
        Qty(locus: "player", resource: "stamina", cmp: Eq, value: 80),
    ],
    capture_points: [
        (name: "critical_complete", after_step: 7, kind: semantic),
    ],
    max_ticks: 24,
    depends_on: [
        "mini-tapestry-traverse",
        "mini-tapestry-combat",
        "mini-tapestry-checkpoint",
        "mini-tapestry-camera",
        "mini-tapestry-hud",
        "mini-tapestry-accessibility",
        "mini-tapestry-credits",
    ],
    anchors: [],
    modules: [],
)
