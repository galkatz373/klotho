(
    outcome: "KAI-MINI-TAPESTRY-001",
    request: "Author a ten-minute single-Place keep adventure with traversal, combat, checkpoint save, camera, production HUD, three locales, accessibility settings, credits, and a desktop package. Use only the approved kitbash. Pin without title code.",
    assumption: "The keep is hearth; the brass key is iron_key; the sentry is kel; the checkpoint is anvil.",
    player: "player",
    place: "hearth",
    passage: "oak_door",
    key: "iron_key",
    foe: "kel",
    checkpoint: "anvil",
    locales: ["en", "ja", "es"],
    skus: ["win-d3d12-high", "linux-vulkan-high", "mac-metal-high"],
    journeys: [
        "traverse.ron",
        "combat.ron",
        "checkpoint.ron",
        "camera.ron",
        "hud.ron",
        "accessibility.ron",
        "credits.ron",
        "critical-path.ron",
    ],
    patterns: [
        (instance: "keep_lock", pattern: "traversal.door_key", version: 2, args: [("passage", "oak_door"), ("key", "iron_key")]),
        (instance: "keep_melee", pattern: "combat.light_heavy", version: 1, args: [("actor", "player"), ("target", "kel")]),
        (instance: "keep_checkpoint", pattern: "traversal.checkpoint", version: 1, args: [("target", "anvil")]),
        (instance: "keep_save", pattern: "production.save_checkpoint", version: 1, args: [("target", "anvil")]),
        (instance: "keep_camera", pattern: "feel.camera_response", version: 1, args: [("actor", "player")]),
        (instance: "keep_feel", pattern: "feel.action_contract", version: 1, args: [("actor", "player")]),
        (instance: "keep_access", pattern: "feel.accessibility", version: 1, args: [("actor", "player")]),
        (instance: "keep_prompt", pattern: "ui.knows_gated_prompt", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "keep_remap", pattern: "ui.remappable_action", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "keep_subs", pattern: "ui.subtitle_cue", version: 1, args: [("actor", "player"), ("action", "talk")]),
        (instance: "keep_toggle", pattern: "ui.hold_toggle", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "keep_contrast", pattern: "ui.contrast_variant", version: 1, args: [("actor", "player"), ("action", "use")]),
    ],
    approved_bindings: [
        ("hearth", "place.hearth.interior"),
        ("player", "npc.human.biped"),
        ("oak_door", "door.oak.lockable"),
        ("iron_key", "relic.key"),
        ("kel", "npc.human.biped"),
        ("fathers_hammer", "relic.hammer"),
        ("anvil", "prop.anvil"),
    ],
)
