(
    outcome: "KAI-TAPESTRY-001",
    request: "Build a bounded thirty-minute action-adventure route across eight Places with combat, traversal, an optional quest, compiled Mind, dialogue, a cinematic, save and resume, localization, accessibility, telemetry, final approved media, and desktop packages.",
    assumption: "The observatory road uses the approved blue-stone and brass constitution; the optional tablet never blocks the critical path.",
    duration_minutes: 30,
    auth_hz: 30,
    present_hz: (60, 120),
    player: "player",
    start_place: "hub",
    passage: "oak_door",
    key: "iron_key",
    foe: "kel",
    checkpoint: "anvil",
    places: ["hub", "combat", "traverse", "talk", "cinema", "rest", "shortcut", "optional"],
    systems: ["combat", "traversal", "optional_quest", "compiled_mind", "dialogue", "cinematic", "save_resume", "localization", "accessibility", "telemetry", "desktop_package"],
    locales: ["en", "ja", "es"],
    skus: ["win-d3d12-high", "linux-vulkan-high", "mac-metal-high"],
    journeys: ["route.ron", "gameplay.ron", "bot-reachability.ron"],
    patterns: [
        (instance: "route_lock", pattern: "traversal.door_key", version: 2, args: [("passage", "oak_door"), ("key", "iron_key")]),
        (instance: "route_combat", pattern: "combat.light_heavy", version: 1, args: [("actor", "player"), ("target", "kel")]),
        (instance: "guard_policy", pattern: "ai.guard_chase_return", version: 1, args: [("actor", "kel")]),
        (instance: "optional_tablet", pattern: "quest.optional_objective", version: 1, args: [("actor", "player"), ("item", "observatory_tablet")]),
        (instance: "mira_dialogue", pattern: "narrative.conditional_conversation", version: 1, args: [("actor", "mira"), ("topic", "observatory_tablet")]),
        (instance: "route_cinematic", pattern: "narrative.cinematic_beat", version: 1, args: [("actor", "mira"), ("topic", "observatory_tablet")]),
        (instance: "route_checkpoint", pattern: "traversal.checkpoint", version: 1, args: [("target", "anvil")]),
        (instance: "route_save", pattern: "production.save_checkpoint", version: 1, args: [("target", "anvil")]),
        (instance: "route_telemetry", pattern: "production.analytics_marker", version: 1, args: [("target", "shortcut")]),
        (instance: "route_camera", pattern: "feel.camera_response", version: 1, args: [("actor", "player")]),
        (instance: "route_feel", pattern: "feel.action_contract", version: 1, args: [("actor", "player")]),
        (instance: "route_haptics", pattern: "feel.haptic_cue", version: 1, args: [("actor", "player")]),
        (instance: "route_access", pattern: "feel.accessibility", version: 1, args: [("actor", "player")]),
        (instance: "route_prompt", pattern: "ui.knows_gated_prompt", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "route_remap", pattern: "ui.remappable_action", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "route_subtitles", pattern: "ui.subtitle_cue", version: 1, args: [("actor", "player"), ("action", "talk_action")]),
        (instance: "route_reader", pattern: "ui.screen_reader", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "route_motion", pattern: "ui.motion_reduction", version: 1, args: [("actor", "player"), ("action", "use")]),
        (instance: "route_focus", pattern: "ui.menu_focus", version: 1, args: [("actor", "player"), ("action", "use")]),
    ],
)
